# ModelSwitch configuration. Copy to .env and adjust. Never commit .env.
# All settings use the MS_ prefix.

# --- Network ---------------------------------------------------------------
# Public inference API. Bind to 0.0.0.0 only if you understand the exposure.
MS_PUBLIC_HOST=127.0.0.1
MS_PUBLIC_PORT=8000
# Management UI/API. Keep this on loopback. It is never placed behind the tunnel.
MS_ADMIN_HOST=127.0.0.1
MS_ADMIN_PORT=8001
MS_PUBLIC_BASE_URL=http://127.0.0.1:8000
MS_ADMIN_BASE_URL=http://127.0.0.1:8001
MS_CORS_ORIGINS=

# --- Paths -----------------------------------------------------------------
MS_DATA_DIR=./data
MS_MODEL_ROOTS=~/models,./models,~/Downloads
# Do not allow arbitrary absolute paths unless explicitly needed (admin-only).
MS_ALLOW_EXTERNAL_MODEL_PATHS=false

# --- llama.cpp -------------------------------------------------------------
# Leave empty for auto-detection of vendor/llama-build/bin, PATH, common dirs.
MS_LLAMA_SERVER_BIN=
MS_LLAMA_THREADS=0
MS_LLAMA_N_GPU_LAYERS=-1
MS_LLAMA_BATCH_SIZE=2048
MS_LLAMA_UBATCH_SIZE=512
MS_BACKEND_START_TIMEOUT=120
MS_BACKEND_IDLE_TIMEOUT=900
MS_MAX_RESIDENT_MODELS=2
MS_MODEL_CONCURRENCY=2
MS_BACKEND_READY_GRACE=5

# --- Requests / scheduling -------------------------------------------------
MS_REQUEST_TIMEOUT=300
MS_QUEUE_TIMEOUT=120
MS_MAX_QUEUE_SIZE=64
MS_MAX_REQUEST_BYTES=2097152
MS_DEFAULT_MAX_TOKENS=1024
MS_MEMORY_SAFETY_FACTOR=0.82
MS_MIN_FREE_RAM_MB=1024

# --- Authentication --------------------------------------------------------
MS_DEFAULT_RATE_LIMIT_RPM=120
MS_DEFAULT_RATE_LIMIT_TPM=200000
MS_ADMIN_RATE_LIMIT_RPM=600
MS_KEY_PEPPER=
MS_TRUST_PROXY=false

# --- Router ----------------------------------------------------------------
MS_ROUTER_STRATEGY=balanced
MS_ROUTER_LLM_ENABLED=false
MS_ROUTER_LLM_MODEL=
MS_ROUTER_LLM_TIMEOUT_MS=2500
MS_ROUTER_AMBIGUITY_THRESHOLD=0.55
MS_ROUTER_HISTORY_RETENTION_DAYS=30
MS_ROUTER_PRIORITIZE_LOADED=true

# --- Cloudflare (optional) -------------------------------------------------
# Prefer supplying CLOUDFLARE_TUNNEL_TOKEN in the environment. Dashboard-entered
# tokens are stored in a 0600 file under the data directory.
CLOUDFLARE_TUNNEL_TOKEN=
MS_CLOUDFLARE_BIN=
MS_CLOUDFLARE_PUBLIC_URL=

# --- Logging ---------------------------------------------------------------
MS_LOG_LEVEL=INFO
MS_LOG_JSON=true
