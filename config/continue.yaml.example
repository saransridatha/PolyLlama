# Continue (VS Code / JetBrains)
# Copy and replace the API key. Keep this file out of source control if it
# contains a real credential.
models:
  - name: ModelSwitch Auto
    provider: openai
    model: auto
    apiBase: http://127.0.0.1:8000/v1
    apiKey: <your-inference-key>
    roles: [chat, edit, apply]
    defaultCompletionOptions:
      contextLength: 8192
  - name: ModelSwitch Coding
    provider: openai
    model: coding
    apiBase: http://127.0.0.1:8000/v1
    apiKey: <your-inference-key>
    roles: [edit, apply]
